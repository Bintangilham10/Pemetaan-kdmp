# Local Compose only. Prefer `npm run setup` to generate independent random secrets.
COMPOSE_PROJECT_NAME=kdmp-foundation
POSTGRES_DB=kdmp
POSTGRES_USER=kdmp_owner
POSTGRES_PASSWORD=replace-with-random-admin-secret
MIGRATOR_PASSWORD=replace-with-random-migrator-secret
API_DB_PASSWORD=replace-with-random-api-secret
WEB_PORT=3000
API_PORT=8000
DB_PORT=55432
# Demonstration basemap; configure a licensed provider before production.
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
