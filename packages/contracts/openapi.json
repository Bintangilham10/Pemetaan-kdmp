{
  "components": {
    "schemas": {
      "CooperativeCollection": {
        "properties": {
          "features": {
            "items": {
              "$ref": "#/components/schemas/CooperativeFeature"
            },
            "title": "Features",
            "type": "array"
          },
          "numberReturned": {
            "title": "Numberreturned",
            "type": "integer"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          },
          "type": {
            "const": "FeatureCollection",
            "default": "FeatureCollection",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "features",
          "numberReturned",
          "truncated"
        ],
        "title": "CooperativeCollection",
        "type": "object"
      },
      "CooperativeFeature": {
        "properties": {
          "geometry": {
            "$ref": "#/components/schemas/PointGeometry"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "properties": {
            "$ref": "#/components/schemas/CooperativeProperties"
          },
          "type": {
            "const": "Feature",
            "default": "Feature",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "geometry",
          "properties"
        ],
        "title": "CooperativeFeature",
        "type": "object"
      },
      "CooperativeProperties": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "village_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Village Code"
          }
        },
        "required": [
          "name",
          "village_code",
          "source"
        ],
        "title": "CooperativeProperties",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LiveStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LiveStatus",
        "type": "object"
      },
      "PointGeometry": {
        "properties": {
          "coordinates": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "Point",
            "default": "Point",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "coordinates"
        ],
        "title": "PointGeometry",
        "type": "object"
      },
      "ReadyStatus": {
        "properties": {
          "database": {
            "const": "ok",
            "default": "ok",
            "title": "Database",
            "type": "string"
          },
          "schema": {
            "const": "ok",
            "default": "ok",
            "title": "Schema",
            "type": "string"
          },
          "spatial": {
            "const": "ok",
            "default": "ok",
            "title": "Spatial",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadyStatus",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Public, bounded geospatial reads. No administrative writes in this phase.",
    "title": "Merah Putih WebGIS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/cooperatives": {
      "get": {
        "description": "Return public cooperative points inside a bounded map viewport.",
        "operationId": "list_cooperatives",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 500,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "west,south,east,north in EPSG:4326; no antimeridian crossing",
            "in": "query",
            "name": "bbox",
            "required": true,
            "schema": {
              "description": "west,south,east,north in EPSG:4326; no antimeridian crossing",
              "examples": [
                "95,-11,141,6"
              ],
              "maxLength": 120,
              "minLength": 7,
              "title": "Bbox",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CooperativeCollection"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Cooperatives",
        "tags": [
          "cooperatives"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    }
  }
}
